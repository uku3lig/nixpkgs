+  twRegex = re2"(?<=(?<!\S)https:\/\/|(?<=\s))(www\.|mobile\.)?twitter\.com"
+  twLinkRegex = re2"""<a href="https:\/\/twitter.com([^"]+)">twitter\.com(\S+)</a>"""
